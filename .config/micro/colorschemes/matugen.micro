color-link default "#e2e3d8"
color-link comment "#8f9285"
color-link selection "#223600,#374d13"
color-link hlsearch "#c1caac"

color-link identifier "#b4d087"
color-link identifier.class "#b4d087"
color-link identifier.var "#b4d087"

color-link constant "#a0d0ca"
color-link constant.number "#a0d0ca"
color-link constant.string "#c1caac"

color-link symbol "#1f4e4a"
color-link symbol.brackets "#c5c8b9"
color-link symbol.tag "#b4d087"

color-link type "#b4d087"
color-link type.keyword "#c1caac"

color-link special "#1f4e4a"
color-link statement "#374d13"
color-link preproc "#1f4e4a"

color-link underlined "#c1caac"
color-link error "bold #ffb4ab"
color-link todo "bold #a0d0ca"

color-link diff-added "#c1caac"
color-link diff-modified "#a0d0ca"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#a0d0ca"

color-link scrollbar "#c5c8b9"
color-link statusline "#e2e3d8,#12140e"
color-link tabbar "#e2e3d8,#12140e"
color-link indent-char "#45483d"
color-link line-number "#45483d"
color-link current-line-number "#b4d087"

color-link cursor-line "#45483d,#e2e3d8"
color-link color-column "#45483d"
color-link type.extended "default"
