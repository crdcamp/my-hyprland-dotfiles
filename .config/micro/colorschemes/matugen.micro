color-link default "#e1e2e9"
color-link comment "#8d9199"
color-link selection "#00315d,#204876"
color-link hlsearch "#bcc7db"

color-link identifier "#a4c9fe"
color-link identifier.class "#a4c9fe"
color-link identifier.var "#a4c9fe"

color-link constant "#d9bde3"
color-link constant.number "#d9bde3"
color-link constant.string "#bcc7db"

color-link symbol "#543f5e"
color-link symbol.brackets "#c3c6cf"
color-link symbol.tag "#a4c9fe"

color-link type "#a4c9fe"
color-link type.keyword "#bcc7db"

color-link special "#543f5e"
color-link statement "#204876"
color-link preproc "#543f5e"

color-link underlined "#bcc7db"
color-link error "bold #ffb4ab"
color-link todo "bold #d9bde3"

color-link diff-added "#bcc7db"
color-link diff-modified "#d9bde3"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#d9bde3"

color-link scrollbar "#c3c6cf"
color-link statusline "#e1e2e9,#111318"
color-link tabbar "#e1e2e9,#111318"
color-link indent-char "#43474e"
color-link line-number "#43474e"
color-link current-line-number "#a4c9fe"

color-link cursor-line "#43474e,#e1e2e9"
color-link color-column "#43474e"
color-link type.extended "default"
