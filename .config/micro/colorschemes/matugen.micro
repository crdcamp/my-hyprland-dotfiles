color-link default "#e6e1e9"
color-link comment "#938f99"
color-link selection "#34275e,#4b3e76"
color-link hlsearch "#cbc3dc"

color-link identifier "#cdbdff"
color-link identifier.class "#cdbdff"
color-link identifier.var "#cdbdff"

color-link constant "#eeb8c9"
color-link constant.number "#eeb8c9"
color-link constant.string "#cbc3dc"

color-link symbol "#633b49"
color-link symbol.brackets "#cac4cf"
color-link symbol.tag "#cdbdff"

color-link type "#cdbdff"
color-link type.keyword "#cbc3dc"

color-link special "#633b49"
color-link statement "#4b3e76"
color-link preproc "#633b49"

color-link underlined "#cbc3dc"
color-link error "bold #ffb4ab"
color-link todo "bold #eeb8c9"

color-link diff-added "#cbc3dc"
color-link diff-modified "#eeb8c9"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#eeb8c9"

color-link scrollbar "#cac4cf"
color-link statusline "#e6e1e9,#141318"
color-link tabbar "#e6e1e9,#141318"
color-link indent-char "#48454e"
color-link line-number "#48454e"
color-link current-line-number "#cdbdff"

color-link cursor-line "#48454e,#e6e1e9"
color-link color-column "#48454e"
color-link type.extended "default"
