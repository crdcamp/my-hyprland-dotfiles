color-link default "#eee0d4"
color-link comment "#9c8e81"
color-link selection "#472a00,#663e00"
color-link hlsearch "#dfc2a2"

color-link identifier "#f8bb71"
color-link identifier.class "#f8bb71"
color-link identifier.var "#f8bb71"

color-link constant "#bbcd9e"
color-link constant.number "#bbcd9e"
color-link constant.string "#dfc2a2"

color-link symbol "#3d4b27"
color-link symbol.brackets "#d4c4b5"
color-link symbol.tag "#f8bb71"

color-link type "#f8bb71"
color-link type.keyword "#dfc2a2"

color-link special "#3d4b27"
color-link statement "#663e00"
color-link preproc "#3d4b27"

color-link underlined "#dfc2a2"
color-link error "bold #ffb4ab"
color-link todo "bold #bbcd9e"

color-link diff-added "#dfc2a2"
color-link diff-modified "#bbcd9e"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#bbcd9e"

color-link scrollbar "#d4c4b5"
color-link statusline "#eee0d4,#18120c"
color-link tabbar "#eee0d4,#18120c"
color-link indent-char "#504539"
color-link line-number "#504539"
color-link current-line-number "#f8bb71"

color-link cursor-line "#504539,#eee0d4"
color-link color-column "#504539"
color-link type.extended "default"
