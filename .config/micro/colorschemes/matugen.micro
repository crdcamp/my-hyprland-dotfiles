color-link default "#dee3e6"
color-link comment "#8a9296"
color-link selection "#003543,#004e60"
color-link hlsearch "#b3cad4"

color-link identifier "#87d1eb"
color-link identifier.class "#87d1eb"
color-link identifier.var "#87d1eb"

color-link constant "#c2c3eb"
color-link constant.number "#c2c3eb"
color-link constant.string "#b3cad4"

color-link symbol "#424465"
color-link symbol.brackets "#bfc8cc"
color-link symbol.tag "#87d1eb"

color-link type "#87d1eb"
color-link type.keyword "#b3cad4"

color-link special "#424465"
color-link statement "#004e60"
color-link preproc "#424465"

color-link underlined "#b3cad4"
color-link error "bold #ffb4ab"
color-link todo "bold #c2c3eb"

color-link diff-added "#b3cad4"
color-link diff-modified "#c2c3eb"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#c2c3eb"

color-link scrollbar "#bfc8cc"
color-link statusline "#dee3e6,#0f1416"
color-link tabbar "#dee3e6,#0f1416"
color-link indent-char "#40484c"
color-link line-number "#40484c"
color-link current-line-number "#87d1eb"

color-link cursor-line "#40484c,#dee3e6"
color-link color-column "#40484c"
color-link type.extended "default"
